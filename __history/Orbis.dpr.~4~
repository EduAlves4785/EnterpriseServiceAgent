program Orbis;

uses
  Vcl.Forms,
  Vcl.Themes,
  Vcl.Styles,
  Core in 'src\Core\Core.pas',
  Logger in 'src\Loggin\Logger.pas' {$R *.res},
  MainForm in 'src\UI\MainForm.pas' {MainForm},
  DBConnection in 'src\Core\Database\DBConnection.pas' {TDBConnection},
  AppConfig in 'src\Config\AppConfig.pas' {DataModule2: TDataModule},
  SettingsForm in 'src\UI\SettingsForm.pas' {Form2},
  ServiceRepository in 'src\Core\Database\ServiceRepository.pas',
  ServiceMonitor in 'src\Monitoring\ServiceMonitor.pas',
  IncidentRepository in 'src\Core\Database\IncidentRepository.pas',
  ApiClient in 'src\Api\ApiClient.pas';

{$R *.res}

begin
  Application.Initialize;

  //Valida se nome da estação está preenchido
  EnsureEstacaoConfigurada;

  try
    Log('Iniciando aplicação...');

    Application.MainFormOnTaskbar := True;
    Application.CreateForm(TDBConnection, DataBaseConnection);
  {Application.CreateForm(TDBConnection, DataBaseConnection);}
    DataBaseConnection.Connect;

    Application.CreateForm(TMainForm, Form1);

    Log('Aplicação iniciada');
    Log('Status do monitoramento: Parado');
    Application.Run;

  finally
    Log('Aplicação finalizada');

    DataBaseConnection.Disconnect;
    DataBaseConnection.Free;
  end;
end.
