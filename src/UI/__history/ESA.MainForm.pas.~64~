unit ESA.MainForm;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ComCtrls, Vcl.ExtCtrls, AppConfig,
  Vcl.Buttons,Logger, Vcl.Menus, SettingsForm, ServiceMonitor, IncidentRepository;

type
  TMainForm = class(TForm)
    Label1: TLabel;
    txtRotaApi: TEdit;
    panelConfig: TPanel;
    Button1: TButton;
    panelStatus: TPanel;
    Label2: TLabel;
    btnStatus: TSpeedButton;
    panelAPI: TPanel;
    Panel1: TPanel;
    Label3: TLabel;
    txtNumChamados: TLabel;
    TrayIcon: TTrayIcon;
    pmTray: TPopupMenu;
    miMostrar: TMenuItem;
    miFechar: TMenuItem;
    tmMonitor: TTimer;
    procedure FormCreate(Sender: TObject);
    procedure btnStatusClick(Sender: TObject);
    procedure FormDblClick(Sender: TObject);
    procedure miMostrarClick(Sender: TObject);
    procedure miFecharClick(Sender: TObject);
    procedure FormCloseQuery(Sender: TObject; var CanClose: Boolean);
    procedure FormResize(Sender: TObject);
    procedure Button1Click(Sender: TObject);
    procedure tmMonitorTimer(Sender: TObject);
    procedure ReloadConfig;
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  MainForm: TMainForm;
  Cfg: TApiConfig;

implementation


{$R *.dfm}

procedure TMainForm.btnStatusClick(Sender: TObject);
begin
  if btnStatus.Caption='Parado' then
  begin
      btnStatus.Font.Color:=clGreen;
      btnStatus.Caption:='Ativo';
      tmMonitor.Enabled:=True;
      Log('Status do monitoramento: Ativo');
  end
  else
    begin
      btnStatus.Font.Color:=clRed;
      btnStatus.Caption:='Parado';
      tmMonitor.Enabled:=False;
      Log('Status do monitoramento: Parado');
    end;

end;

procedure TMainForm.Button1Click(Sender: TObject);
begin
  with TSettingsForm.Create(Self) do
  try
    if ShowModal=mrOk then
      begin
        ReloadConfig;
      end;
  finally
    Free;
  end;
end;

procedure TMainForm.FormCloseQuery(Sender: TObject; var CanClose: Boolean);
begin
   if not Application.Terminated then
  begin
    CanClose := False;
    WindowState := wsMinimized;
  end;
end;

procedure TMainForm.FormCreate(Sender: TObject);
var
  NumChamados:Integer;
begin
    Cfg:=GetAPIConfig;
    NumChamados:=TIncidentRepository.IcidentOpenToday;
    txtRotaApi.Text:=Cfg.ApiRoute;
    txtNumChamados.Caption:= IntToStr(NumChamados);
end;

procedure TMainForm.FormDblClick(Sender: TObject);
begin
  Show;
  WindowState := wsNormal;
  TrayIcon.Visible := False;
end;

procedure TMainForm.FormResize(Sender: TObject);
begin
   if WindowState = wsMinimized then
  begin
    Hide;
    TrayIcon.Visible := True;
  end;
end;

procedure TMainForm.miFecharClick(Sender: TObject);
begin
  TrayIcon.Visible := False;
  Application.Terminate;
end;

procedure TMainForm.miMostrarClick(Sender: TObject);
begin
   Show;
  WindowState := wsNormal;
  TrayIcon.Visible := False;
end;

procedure TMainForm.ReloadConfig;
begin
  Cfg:=GetAPIConfig;
  txtRotaApi.Text:=Cfg.ApiRoute;
end;

procedure TMainForm.tmMonitorTimer(Sender: TObject);
begin
  TServiceMonitor.CheckServices;
end;

end.
